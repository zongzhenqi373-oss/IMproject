# 百炼 Anthropic 兼容接口示例；Base URL 以 /apps/anthropic 结尾。
AI_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/apps/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=qwen3.7-plus

# 以下配置通常保持默认即可。
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=180
# 百炼千问关闭深度思考，降低聊天候选回复的延迟和Token消耗。
AI_DISABLE_THINKING=true
AI_ENABLED=true
# 灰度比例：0=全关，100=全开；按 userId 稳定分桶。
AI_ROLLOUT_PERCENT=100
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_CONTEXT_BYTES=12000
AI_MAX_MESSAGE_BYTES=2000
AI_RATE_LIMIT_PER_MINUTE=5
AI_MAX_PENDING_REQUESTS=8
AI_REPLAY_WINDOW_SECONDS=300

# 使用自建 CA 或代理证书时填写；系统可信 CA 无需填写。
AI_CA_CERT_PATH=
